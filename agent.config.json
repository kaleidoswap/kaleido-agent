{
  "agent": {
    "model": "claude-sonnet-4-6",
    "max_tokens": 4096,
    "max_tool_calls_per_run": 30,
    "mode": "mcp"
  },
  "mcp": {
    "kaleido": {
      "command": "node",
      "args": [
        "../kaleido-mcp/dist/index.js"
      ],
      "env": {
        "WDK_SEED": "",
        "SPARK_NETWORK": "MAINNET",
        "SPARK_USDT_TOKEN": "",
        "RLN_NODE_URL": "http://localhost:3001",
        "KALEIDOSWAP_API_URL": "https://api.staging.kaleidoswap.com"
      }
    }
  },
  "portfolio": {
    "targets": {
      "BTC": 70,
      "USDT": 20,
      "XAUT": 10
    },
    "rebalance_threshold_pct": 5,
    "max_swap_usd": 200,
    "min_btc_reserve_sats": 50000,
    "max_concurrent_orders": 3,
    "stop_loss_btc_sats": 30000,
    "dry_run": true,
    "trading_mode": "atomic",
    "lsp": {
      "lsp_balance_sat": 500000,
      "client_balance_sat": 20000,
      "channel_expiry_blocks": 4320,
      "min_outbound_liquidity_sat": 2000,
      "auto_buy_channel": true
    }
  },
  "schedule": {
    "rebalance_interval_sec": 0,
    "heartbeat_interval_sec": 300,
    "daily_summary_cron": "00:00"
  },
  "notifications": {
    "log_file": "logs/kaleidoagent.log",
    "log_level": "INFO"
  },
  "skills": {
    "enabled": [
      "mpp",
      "cross-l2",
      "node-manager",
      "dca",
      "kaleidoagent",
      "kaleidoswap",
      "portfolio-manager",
      "channel-manager",
      "wallet-assistant"
    ]
  }
}
