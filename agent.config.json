{
  "agent": {
    "model": "claude-sonnet-4-6",
    "max_tokens": 2048,
    "max_tool_calls_per_run": 20
  },
  "mcp": {
    "kaleidoswap": {
      "command": "node",
      "args": ["../kaleidoswap-mcp/dist/index.js"],
      "env": {
        "KALEIDOSWAP_API_URL": "https://api.staging.kaleidoswap.com"
      }
    },
    "wdk_wallet": {
      "command": "node",
      "args": ["../wdk-wallet-mcp/dist/index.js"],
      "env": {
        "RLN_NODE_URL": "http://localhost:3001"
      }
    },
    "mpp_gateway": {
      "command": "node",
      "args": ["../mpp-gateway-mcp/dist/index.js"],
      "env": {
        "MPP_GATEWAY_URL": ""
      }
    },
    "kaleido_node": {
      "command": "node",
      "args": ["../kaleido-node-mcp/dist/index.js"],
      "env": {
        "KALEIDO_NODE_URL": "http://localhost:3001",
        "KALEIDO_API_URL": "https://api.staging.kaleidoswap.com"
      }
    }
  },
  "portfolio": {
    "targets": {
      "BTC": 70,
      "USDT": 20,
      "XAUT": 10
    },
    "rebalance_threshold_pct": 5,
    "max_swap_usd": 200,
    "min_btc_reserve_sats": 50000,
    "max_concurrent_orders": 3,
    "stop_loss_btc_sats": 30000,
    "dry_run": true,
    "trading_mode": "atomic",
    "lsp": {
      "lsp_balance_sat": 2000000,
      "client_balance_sat": 0,
      "channel_expiry_blocks": 4320,
      "min_outbound_liquidity_sat": 200000,
      "auto_buy_channel": true
    }
  },
  "schedule": {
    "rebalance_interval_sec": 3600,
    "heartbeat_interval_sec": 3600,
    "daily_summary_cron": "00:00"
  },
  "assets": {
    "btc_asset_id": "BTC",
    "usdt_asset_id": "rgb:i~xXdG4J-JfXE_QX-RRVCDbQ-ggISPWO-P2yxBGT-nQX19SQ",
    "xaut_asset_id": "rgb:Vf25LAhx-tcikQu3-O3msZ7~-DcNF4YH-8FCe1FC-Brh2rIc"
  },
  "notifications": {
    "log_file": "logs/kaleidoagent.log",
    "log_level": "INFO"
  }
}
